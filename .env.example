# Copy to .env (gitignored). Use your own BSC testnet node or a provider key: fork tests read a lot of state.
BSC_TESTNET_RPC_URL=
# One BIP-39 seed phrase for every account (scripts/keys.sh): index 0 deployer/owner, 9 operator,
# 3 creator, 5 maker, 6/7 takers. Empty = anvil's public test mnemonic (fork only). Required for
# scripts/testnet.sh. `scripts/wallets.sh` lists the addresses and the tBNB each needs.
MNEMONIC=
# Optional: an etherscan.io API key (Etherscan V2 covers BscScan testnet). With it, scripts/testnet.sh verifies
# every contract it deploys on BscScan (retry: scripts/testnet.sh --verify, or scripts/verify.sh).
ETHERSCAN_API_KEY=
